<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Find healthy recipes with complete nutritional details. Stay fit and enjoy delicious meals!">
    <title>Home - Healthy Recipes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Healthy Recipes</a>
            
            <!-- Navigation items on the right -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item active">
                        <a class="nav-link" href="index.html">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="recipes.html">Recipes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="submit.html">Add Recipe</a>
                    </li>                    
                </ul>
            </div>
        </div>
    
        <!-- Centered search bar -->
        <div class="container-fluid text-center">
            <form class="d-flex justify-content-center my-2">
                <input class="form-control me-2" type="search" placeholder="Search recipes" aria-label="Search">
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-section">
        <div class="container text-center">
            <h1>Welcome to Healthy Recipes</h1>
            <p>Your go-to destination for nutritious and delicious meal ideas. Explore recipes that fuel your body and your taste buds!</p>
        </div>
    </header>

    <!-- Why Choose Us Section -->
    <section class="why-choose-us">
        <div class="container text-center">
            <h2>Why Choose Healthy Recipes?</h2>
            <div class="row">
                <div class="col-lg-4 col-md-6">
                    <div class="feature-box">
                        <img src="https://images.pexels.com/photos/28962427/pexels-photo-28962427/free-photo-of-gourmet-flatbread-with-red-cabbage-topping.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" alt="Nutritional Information" class="img-fluid">
                        <h3>Complete Nutritional Info</h3>
                        <p>Each recipe comes with detailed nutritional information like calories, proteins, fats, and more to keep your diet on track.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="feature-box">
                        <img src="https://images.pexels.com/photos/2262045/pexels-photo-2262045.png?auto=compress&cs=tinysrgb&w=600" alt="Healthy Ingredients" class="img-fluid">
                        <h3>Fresh Ingredients</h3>
                        <p>Our recipes use fresh and wholesome ingredients that promote overall health and well-being.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="feature-box">
                        <img src="https://images.pexels.com/photos/4099237/pexels-photo-4099237.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" alt="Quick and Easy" class="img-fluid">
                        <h3>Quick & Easy to Make</h3>
                        <p>Our recipes are designed to be quick, easy, and beginner-friendly, so you can enjoy delicious meals without the hassle.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Popular Recipes Section -->
    <section class="popular-recipes">
        <div class="container text-center">
            <h2>Popular Recipes</h2>
            <div class="row">
                <!-- Existing Recipes -->
                <div class="col-lg-4 col-md-6">
                    <div class="card recipe-card">
                        <img src="https://images.pexels.com/photos/842571/pexels-photo-842571.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" class="card-img-top" alt="Healthy Salad">
                        <div class="card-body">
                            <h5 class="card-title">Healthy Salad</h5>
                            <p class="card-text">A light and nutritious salad perfect for a healthy meal.</p>
                            <ul class="list-unstyled">
                                <li><strong>Calories:</strong> 250 kcal</li>
                                <li><strong>Protein:</strong> 10g</li>
                                <li><strong>Carbs:</strong> 35g</li>
                                <li><strong>Fat:</strong> 10g</li>
                            </ul>
                            <a href="recipe-detail.html" class="btn btn-primary">View Recipe</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="card recipe-card">
                        <img src="https://images.pexels.com/photos/106343/pexels-photo-106343.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" class="card-img-top" alt="Quinoa Bowl">
                        <div class="card-body">
                            <h5 class="card-title">Quinoa Bowl</h5>
                            <p class="card-text">A protein-packed quinoa bowl loaded with veggies.</p>
                            <ul class="list-unstyled">
                                <li><strong>Calories:</strong> 400 kcal</li>
                                <li><strong>Protein:</strong> 15g</li>
                                <li><strong>Carbs:</strong> 55g</li>
                                <li><strong>Fat:</strong> 10g</li>
                            </ul>
                            <a href="recipe-detail.html" class="btn btn-primary">View Recipe</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="card recipe-card">
                        <img src="https://images.pexels.com/photos/4086805/pexels-photo-4086805.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" class="card-img-top" alt="Fruit Smoothie">
                        <div class="card-body">
                            <h5 class="card-title">Fruit Smoothie</h5>
                            <p class="card-text">A refreshing smoothie made with fresh fruits.</p>
                            <ul class="list-unstyled">
                                <li><strong>Calories:</strong> 150 kcal</li>
                                <li><strong>Protein:</strong> 5g</li>
                                <li><strong>Carbs:</strong> 30g</li>
                                <li><strong>Fat:</strong> 2g</li>
                            </ul>
                            <a href="recipe-detail.html" class="btn btn-primary">View Recipe</a>
                        </div>
                    </div>
                </div>

                <!-- Displaying recipes from the database -->
                <% recipes.forEach(recipe => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card recipe-card">
                        <img src="<%= recipe.imageURL %>" class="card-img-top" alt="<%= recipe.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= recipe.title %></h5>
                            <p class="card-text"><%= recipe.description %></p>
                            <ul class="list-unstyled">
                                <li><strong>Calories:</strong> <%= recipe.calories %> kcal</li>
                                <li><strong>Protein:</strong> <%= recipe.protein %>g</li>
                                <li><strong>Carbs:</strong> <%= recipe.carbs %>g</li>
                                <li><strong>Fat:</strong> <%= recipe.fat %>g</li>
                            </ul>
                            <a href="recipe-detail.html" class="btn btn-primary">View Recipe</a>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Footer Section -->
    <footer class="bg-dark text-white text-center py-4">
        <p>&copy; 2024 Healthy Recipes. All Rights Reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelector('form').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent form submission
            const query = document.querySelector('input[type="search"]').value.toLowerCase();
            // Redirect to search results page or filter recipes (if you have that feature)
            alert(`Searching for: ${query}`);
        });
    </script>
</body>
</html>

